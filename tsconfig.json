{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": "build",
    "declaration": false,
    "sourceMap": false,
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": [
    "plugin/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["plugin/dist", "plugin/runtime", "plugin/renderer", "build"]
}
